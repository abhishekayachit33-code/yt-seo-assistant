# Same values as the root .env -- this backend calls the same root-level
# business logic (keyword_pipeline.py, llm.py, etc.), so it needs the same keys.
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_2=
DEEPSEEK_API_KEY=
SUPADATA_API_KEY=
DATABASE_URL=

# New for the API: signs auth tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Comma-separated. The Next.js dev server origin by default.
CORS_ORIGINS=http://localhost:3000
