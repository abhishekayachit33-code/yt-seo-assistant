.env
__pycache__/
*.pyc
.venv/
.agents/
.claude/
.DS_Store
.pytest_cache/

# YouTube Studio analytics exports. These contain a real channel's private
# per-video performance data (views, impressions, CTR) belonging to someone
# else. Both this repo and the Docker image built from it are PUBLIC, so
# these must never be committed -- they were used locally to validate the
# keyword pipeline and have no place in the shipped artifact.
Content */
Geography */
Traffic source */
*.csv

# YouTube Analytics API OAuth credentials. client_secret*.json is the app's
# OAuth client; yt_analytics_token.json holds a REFRESH TOKEN granting
# ongoing read access to a real channel's private analytics. Both are live
# credentials -- this repo and the image built from it are PUBLIC.
client_secret*.json
yt_analytics_token.json

# Local screenshots / scratch
Screenshot *.png
screenshots

# Generated audit/report artifacts. Not source, and the break-test report
# spells out exploitable detail against a deployed app in a PUBLIC repo.
SEO-System-Break-Test.pdf
*-Break-Test.pdf

# Eval harness cache/results -- derived from a real channel's private
# per-video analytics (Archive 2/, also gitignored), so results carry the
# same privacy concern as the source CSVs even though they're generated.
eval_channel_videos.json
eval_pipeline_backtest_results.json
eval_pipeline_backtest_results_deepseek.json
